# RIMA (Ruang Interaksi Mental Aman) - Environment Configuration Template
# Copy this file to .env or .env.local to configure Supabase integration.
# NOTE: RIMA is designed offline-first; if omitted, all features operate locally in-browser.

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
